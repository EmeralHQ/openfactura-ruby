/.bundle/
# Este gem soporta Ruby >= 3.1: fijar el lockfile obliga a todas las versiones a
# una misma resolución y rompe la matriz de CI. Cada Ruby resuelve la suya.
/Gemfile.lock
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/spec/tmp/
/tmp/
.vscode/
.rspec_status
*.gem
.DS_Store
.env
.env.local

# Claude Code
# Se versiona lo compartido con el equipo: skills/ y README.md.
# Queda fuera lo personal: worktrees, overrides locales y config de tu máquina.
.claude/worktrees/
.claude/settings.local.json
.claude/mcp.json
.claude/scheduled_tasks.lock